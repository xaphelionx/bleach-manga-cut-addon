{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bleach-manga-cut.local/schemas/media/verified-media.schema.json",
  "title": "Verified torrent and local-media evidence record",
  "description": "Technical evidence independent of Bleach editorial sources and generated Stremio output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityDomain",
    "videoId",
    "recordId",
    "verificationState",
    "torrent",
    "media",
    "verificationBases",
    "fieldEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authorityDomain": {
      "const": "verified-media"
    },
    "videoId": {
      "type": "string",
      "pattern": "^(?:cb_[0-9]+(?:p[0-9]+)?|hb_[0-9]+(?:p[0-9]+)?|ch_[0-9]+|hb_ex_[0-9]+)$"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "verificationState": {
      "const": "verified"
    },
    "torrent": {
      "$ref": "#/$defs/torrent"
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "verificationBases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verificationBasis"
      }
    },
    "fieldEvidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "unresolved"
        }
      }
    },
    "verifiedContainerDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "measurement",
        "seconds"
      ],
      "properties": {
        "state": {
          "const": "verified"
        },
        "measurement": {
          "const": "container"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "artifactRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^\\\\"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          }
        ]
      }
    },
    "torrent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infoHash",
        "fileSelection",
        "networkEvidence"
      ],
      "properties": {
        "infoHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fileSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileIdx",
            "filename",
            "byteSize"
          ],
          "properties": {
            "fileIdx": {
              "type": "integer",
              "minimum": 0
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "byteSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "networkEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trackers",
            "announceUrls",
            "webSeeds"
          ],
          "properties": {
            "trackers": {
              "$ref": "#/$defs/unresolved"
            },
            "announceUrls": {
              "$ref": "#/$defs/unresolved"
            },
            "webSeeds": {
              "$ref": "#/$defs/unresolved"
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "video",
        "audioTracks",
        "subtitleTracks"
      ],
      "properties": {
        "duration": {
          "oneOf": [
            {
              "$ref": "#/$defs/unresolved"
            },
            {
              "$ref": "#/$defs/verifiedContainerDuration"
            }
          ]
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "standard",
            "profile",
            "width",
            "height",
            "pixelFormat"
          ],
          "properties": {
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "standard": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "pixelFormat": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "audioTracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioTrack"
          }
        },
        "subtitleTracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subtitleTrack"
          }
        }
      }
    },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "codec",
        "profile",
        "channels",
        "channelLayout"
      ],
      "properties": {
        "language": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/unresolved"
            }
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "channelLayout": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "subtitleTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "language",
        "title"
      ],
      "properties": {
        "kind": {
          "const": "embedded"
        },
        "language": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/unresolved"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localTorrentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "retention",
        "sha256"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/artifactRelativePath"
        },
        "retention": {
          "const": "ignored-local-workspace"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "localTorrentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pieceLength",
        "pieceCount",
        "verifiedPieces",
        "mismatches",
        "rawInfoMatchesCanonicalEncoding",
        "payloadFilenameMatchesLocalMedia",
        "payloadByteSizeMatchesLocalMedia"
      ],
      "properties": {
        "pieceLength": {
          "type": "integer",
          "minimum": 1
        },
        "pieceCount": {
          "type": "integer",
          "minimum": 1
        },
        "verifiedPieces": {
          "type": "integer",
          "minimum": 1
        },
        "mismatches": {
          "const": 0
        },
        "rawInfoMatchesCanonicalEncoding": {
          "const": true
        },
        "payloadFilenameMatchesLocalMedia": {
          "const": true
        },
        "payloadByteSizeMatchesLocalMedia": {
          "const": true
        }
      }
    },
    "localMediaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "retention",
        "byteSize"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/artifactRelativePath"
        },
        "retention": {
          "const": "ignored-local-workspace"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verificationBasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "kind",
            "verificationState",
            "attestation"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "manually-verified-existing-torrent-evidence"
            },
            "verificationState": {
              "const": "verified"
            },
            "attestation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "retainedOriginalArtifact",
                "repositoryOnlyReproduction"
              ],
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "retainedOriginalArtifact": {
                  "const": "not-present-in-repository"
                },
                "repositoryOnlyReproduction": {
                  "const": "unavailable"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "kind",
            "verificationState",
            "method",
            "artifact",
            "verification"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "local-torrent-verification"
            },
            "verificationState": {
              "const": "verified"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/localTorrentArtifact"
            },
            "verification": {
              "$ref": "#/$defs/localTorrentVerification"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "kind",
            "method",
            "verificationState"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "local-media-inspection"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "verificationState": {
              "const": "verified"
            },
            "artifact": {
              "$ref": "#/$defs/localMediaArtifact"
            }
          }
        }
      ]
    }
  }
}
