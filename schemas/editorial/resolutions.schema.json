{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bleach-manga-cut.local/schemas/editorial/resolutions.schema.json",
  "title": "Bleach project-owner editorial resolutions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "authorityDomain",
    "resolutions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactType": {
      "const": "editorial-resolutions"
    },
    "authorityDomain": {
      "const": "project-owner-editorial-decision"
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resolution"
      }
    }
  },
  "$defs": {
    "resolution": {
      "oneOf": [
        {
          "$ref": "#/$defs/guidedPlacementResolution"
        },
        {
          "$ref": "#/$defs/versionMembershipSelectionResolution"
        }
      ]
    },
    "guidedPlacementResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionId",
        "originalIssueId",
        "resolutionState",
        "decisionAuthority",
        "decisionDate",
        "guidedIdentity",
        "resolvedTarget",
        "relativePlacement",
        "guidedPlacement",
        "sourceClaims",
        "rationale"
      ],
      "properties": {
        "resolutionId": {
          "type": "string",
          "pattern": "^editorial-resolution:"
        },
        "originalIssueId": {
          "type": "string",
          "minLength": 1
        },
        "resolutionState": {
          "const": "resolved"
        },
        "decisionAuthority": {
          "const": "project-owner"
        },
        "decisionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "guidedIdentity": {
          "$ref": "#/$defs/guidedIdentity"
        },
        "resolvedTarget": {
          "$ref": "#/$defs/resolvedTarget"
        },
        "relativePlacement": {
          "$ref": "#/$defs/relativePlacement"
        },
        "guidedPlacement": {
          "$ref": "#/$defs/guidedPlacement"
        },
        "sourceClaims": {
          "$ref": "#/$defs/sourceClaims"
        },
        "rationale": {
          "$ref": "#/$defs/rationale"
        }
      }
    },
    "versionMembershipSelectionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionId",
        "originalIssueId",
        "resolutionState",
        "decisionAuthority",
        "decisionDate",
        "resolutionType",
        "projectId",
        "selectedMembership",
        "activeRecordIds",
        "sourceClaims",
        "futureVersionPolicy",
        "rationale"
      ],
      "properties": {
        "resolutionId": {
          "type": "string",
          "pattern": "^editorial-resolution:"
        },
        "originalIssueId": {
          "type": "string",
          "minLength": 1
        },
        "resolutionState": {
          "const": "resolved"
        },
        "decisionAuthority": {
          "const": "project-owner"
        },
        "decisionDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "resolutionType": {
          "const": "version-membership-selection"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "selectedMembership": {
          "const": "current-raw-records"
        },
        "activeRecordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceClaims": {
          "$ref": "#/$defs/versionMembershipSourceClaims"
        },
        "futureVersionPolicy": {
          "$ref": "#/$defs/futureVersionPolicy"
        },
        "rationale": {
          "$ref": "#/$defs/rationale"
        }
      }
    },
    "guidedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "rawIdentifier"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "rawIdentifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolvedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "sourceIdentifier"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "sourceIdentifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relativePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterRecordId",
        "beforeRecordId"
      ],
      "properties": {
        "afterRecordId": {
          "type": "string",
          "minLength": 1
        },
        "beforeRecordId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guidedPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "season",
        "episode"
      ],
      "properties": {
        "seriesId": {
          "type": "string",
          "minLength": 1
        },
        "season": {
          "type": "integer",
          "minimum": 1
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidedIdentifier",
        "resolvedRecord"
      ],
      "properties": {
        "guidedIdentifier": {
          "$ref": "#/$defs/evidenceClaim"
        },
        "resolvedRecord": {
          "$ref": "#/$defs/evidenceClaim"
        }
      }
    },
    "versionMembershipSourceClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionMembershipNotes"
      ],
      "properties": {
        "versionMembershipNotes": {
          "$ref": "#/$defs/evidenceClaim"
        }
      }
    },
    "futureVersionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automaticSupersession",
        "revalidationRequired",
        "revalidationTrigger"
      ],
      "properties": {
        "automaticSupersession": {
          "const": false
        },
        "revalidationRequired": {
          "const": true
        },
        "revalidationTrigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs"
      ],
      "properties": {
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "text"
      ],
      "properties": {
        "classification": {
          "const": "project-owner-decision"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
