{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bleach-manga-cut.local/schemas/projection/video-id-registry.schema.json",
  "title": "Bleach Manga Cut permanent video ID registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "seriesId", "policy", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryId": { "const": "bleach-manga-cut-video-ids" },
    "seriesId": { "const": "bleach-manga-cut" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appendOnly",
        "registryPresenceImpliesPublication",
        "identifiersDependOnPlacement",
        "decimalEncoding",
        "decimalSyntaxImpliesEditorialKind",
        "unknownSyntax"
      ],
      "properties": {
        "appendOnly": { "const": true },
        "registryPresenceImpliesPublication": { "const": false },
        "identifiersDependOnPlacement": { "const": false },
        "decimalEncoding": { "const": "lexical-p-delimiter" },
        "decimalSyntaxImpliesEditorialKind": { "const": false },
        "unknownSyntax": { "const": "validation-error" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordType",
        "recordId",
        "projectId",
        "sourceIdentifier",
        "videoId",
        "status",
        "locked"
      ],
      "properties": {
        "recordType": { "enum": ["normalized-record", "variant"] },
        "recordId": { "type": "string", "minLength": 1 },
        "projectId": { "enum": ["concentrated", "hollowed", "chipped"] },
        "sourceIdentifier": { "type": "string", "minLength": 1 },
        "videoId": {
          "type": "string",
          "pattern": "^(?:cb_[0-9]+(?:p[0-9]+)?|hb_[0-9]+(?:p[0-9]+)?|ch_[0-9]+|hb_ex_[0-9]+)$"
        },
        "status": { "enum": ["reserved", "published"] },
        "locked": { "type": "boolean" }
      }
    }
  }
}
